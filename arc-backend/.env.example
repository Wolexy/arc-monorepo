PORT=4200
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=arcdb

JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=1d

BCRYPT_SALT_ROUNDS=10
EMAIL_VERIFICATION_EXPIRY_HOURS=24

