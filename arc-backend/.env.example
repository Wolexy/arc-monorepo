# Global request limit per client, applied to every route.
# Login and register stay at 5/min and verify-email at 10/min.
THROTTLE_LIMIT=300
THROTTLE_TTL_MS=60000

FRONTEND_URLS=http://localhost:3000
FRONTEND_URL=http://localhost:3000